    "Blocked apps are hidden whenever they come to the front during a focus session. They are never quit, so no work is lost." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engellenen uygulamalar odak seansı sırasında öne geldiklerinde gizlenir. Asla kapatılmazlar, böylece hiçbir çalışman kaybolmaz."
          }
        }
      }
    },
