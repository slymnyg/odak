    "Block distractions during focus sessions" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odak seanslarında dikkat dağıtıcıları engelle"
          }
        }
      }
    },
    "Blocked apps are hidden whenever they come to the front during a focus session. They are never quit, so no work is lost." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engellenen uygulamalar odak seansı sırasında öne geldiklerinde gizlenir. Asla kapatılmazlar, böylece hiçbir çalışman kaybolmaz."
          }
        }
      }
    },
    "Blocking" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engelleme"
          }
        }
      }
    },
    "Blocking %@ and %@" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ve %2$@ engelleniyor"
          }
        }
      }
    },
    "Blocking stays on while a session is paused and turns off during breaks. The lists are saved as you change them and apply right away." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engelleme, seans duraklatıldığında açık kalır ve molalarda kapanır. Listeler değiştirdikçe kaydedilir ve hemen uygulanır."
          }
        }
      }
    },
    "Break is over" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mola bitti"
          }
